# ── Payment ───────────────────────────────────────────────────────────────────
# Active payment provider. "qris" = manual QRIS scan + admin review (default,
# zero per-transaction fees). Flip to "midtrans" later to re-enable Snap
# checkout — no code change required, just set MIDTRANS_SERVER_KEY too.
PAYMENT_PROVIDER="qris"

# Email(s) allowed to access /admin/payments. Comma-separated for multiple.
ADMIN_PAYMENT_EMAIL="riefkyiqbalm@gmail.com"
# Exposed to client — used only to show/hide the Admin Panel link in the UI.
# Keep in sync with ADMIN_PAYMENT_EMAIL above.
NEXT_PUBLIC_ADMIN_PAYMENT_EMAIL="riefkyiqbalm@gmail.com"

# Full URL of the admin app — used client-side to build the admin link.
# Dev: http://localhost:3001   Production: https://admin.aotamata.space
NEXT_PUBLIC_ADMIN_URL="http://japatek.space"

# Hostname that hosts the admin app (e.g. "admin.aotamata.space"). When set:
#   - Main host returns 404 for /admin/* and /api/admin/*.
#   - Admin host serves only /admin, /api/admin, /api/auth, /login, /terms.
# Leave UNSET in dev so /admin/payments stays reachable at localhost:3000.
# Compare is case-insensitive; port is stripped (so "admin.example.com:443"
# matches "admin.example.com").
# ADMIN_HOST= # The Port 3001 is only example.



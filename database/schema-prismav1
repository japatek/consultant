  @@index([sessionId, createdAt])
}

model Message_SolidworksExt {
  id        String   @id @default(cuid())
  sessionId String
  content   String   @db.Text
  role      MessageRole
  createdAt DateTime @default(now())
  session   ChatSession_SolidworksExt @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])

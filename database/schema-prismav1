// Foreign keys bind each Message_X to a single ChatSession_X  making
// cross-platform message queries impossible at the SQL level.

model Message_Website {
  id        String   @id @default(cuid())
  sessionId String
  content   String   @db.Text
  role      MessageRole
  createdAt DateTime @default(now())
  session   ChatSession_Website @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

model Message_BrowserExt {
  id        String   @id @default(cuid())
  sessionId String
  content   String   @db.Text
  role      MessageRole
  createdAt DateTime @default(now())
  session   ChatSession_BrowserExt @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

model Message_OfficeExt {
  id        String   @id @default(cuid())
  sessionId String
  content   String   @db.Text

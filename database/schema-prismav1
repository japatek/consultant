generator client {
  provider = "prisma-client-js" 
  output   = "../node_modules/.prisma/client" 
  url      = env("DATABASE_URL")
}

datasource db {
  provider = "postgresql" // Asumsi menggunakan PostgreSQL karena tipe data seperti jsonb, bytea, int4
}

// ==========================================
// ENUMS
// ==========================================

// Sesuaikan nilai enum Role dengan kebutuhan aplikasi Anda
enum Role {
  USER
  ASSISTANT
}

// Sesuaikan nilai status dengan kebutuhan bisnis logika Anda
enum SubmissionStatus {
  PENDING
  COMPLETED
  INCOMPLETE
}

enum SubscriptionTier {
  FREE
  PERSONAL
  ENTERPRISE
}

enum BillingPeriod {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ==========================================
// APLIKASI UTAMA (APP MODELS)
// ==========================================

model User {
  id               String    @id @default(cuid())
  resetToken       String?    
  verifyToken      String?   
  pendingEmail     String?
  institution      String?
  contact          String?
  image            String?
  password         String
  email            String    @unique
  name             String?
  resetTokenExpiry DateTime?
  tokenExpiry      DateTime?
  emailVerified    DateTime?
  emailNonV        DateTime?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())
  role             Role      @default(USER)

  // Relasi
  documents        Document[]
  websiteChats     ChatSession_Website[]
  browserExtChats  ChatSession_BrowserExt[]
  officeExtChats   ChatSession_OfficeExt[]
  solidworksChats  ChatSession_SolidworksExt[]
  inventorChats    ChatSession_InventorExt[]
  vscodeExtChats   ChatSession_VSCodeExt[]
  subscription     Subscription?
  userSessions     UserSession[]
  apiKeys          UserApiKey[]
  extensionKey     ExtensionAccessKey?
  passwordChangedAt DateTime?
}

// One subscription row per user. Tracks current tier + billing period + expiry.
// Free tier is implicit (no row OR a row with tier=FREE and no expiresAt).

model Subscription {
  userId        String             @id
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier          SubscriptionTier   @default(FREE)
  status        SubscriptionStatus @default(ACTIVE)
  billingPeriod BillingPeriod?
  startedAt     DateTime           @default(now())
  expiresAt     DateTime?
  cancelledAt   DateTime?

  payments      Payment[]
}

model Payment {
  id              String        @id @default(cuid())
  subscriptionId  String
  amountCents     Int
  currency        String        @default("USD")
  provider        String        // "stripe" | "midtrans" | "paypal" | "qris" | "manual"
  externalId      String?       // payment intent / order id from provider
  status          PaymentStatus @default(PENDING)

  // Manual QRIS proof  populated when user uploads receipt screenshot.
  // Cleared on approve/reject to keep the table small.
  proof           Bytes?
  proofMime       String?
  proofRef        String?       // user-supplied reference number (optional)
  proofedAt       DateTime?     // when proof was uploaded
  reviewerEmail   String?       // admin who approved/rejected
  reviewedAt      DateTime?
  rejectReason    String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  subscription    Subscription  @relation(fields: [subscriptionId], references: [userId], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([externalId])
  @@index([status, proofedAt])
}

// Idempotency log  every payment-provider webhook event we've successfully
// processed. Prevents double-applies if the provider retries the webhook.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  externalId  String   // event id from the provider (e.g. Stripe `evt_`)
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, externalId])
}

// Active login sessions  one row per device/browser the user is signed in from.
// JWT carries `sessionId`; when the row is deleted or `revokedAt` is set, the
// token is invalidated on the next authenticated request.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  device       String?
  browser      String?
  os           String?
  ip           String?
  userAgent    String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Document {
  id        String   @id @default(cuid())
  rawText   String?
  fileUrl   String
  fileType  String
  fileName  String
  userId    String
  createdAt DateTime @default(now())

  // Relasi
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id             String           @id @default(cuid())
  targetDomain   String
  documentId     String
  createdAt      DateTime         @default(now())
  missingFields  Json?            // Di ERD tipe: jsont -> Prisma: Json
  extractedData  Json?            
  detectedSchema Json?            
  status         SubmissionStatus 

  // Relasi
  document       Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// Per-platform tables (not a discriminator column)  see MULTIPLE_EXTENSION.md

model ChatSession_Website {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Chat")
  pinnedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message_Website[]
  @@index([userId, updatedAt])
}

model ChatSession_BrowserExt {
  id        String   @id @default(cuid())

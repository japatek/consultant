model Message_VSCodeExt {
  id        String   @id @default(cuid())
  sessionId String
  content   String   @db.Text
  role      MessageRole
  createdAt DateTime @default(now())
  session   ChatSession_VSCodeExt @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}


// ==========================================
// LANGGRAPH CHECKPOINT TABLES
// Didefinisikan agar Prisma mengenali tabel-tabel ini.
// ==========================================

model checkpoints {
  thread_id            String
  checkpoint_ns        String
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String?
  metadata             Json    // Di ERD tipe: jsont -> Prisma: Json
  checkpoint           Json    // Di ERD tipe: jsont -> Prisma: Json

  // Langgraph menggunakan Composite Primary Key
  @@id([thread_id, checkpoint_ns, checkpoint_id])
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String
  channel       String
  version       String
  type          String
  blob          Bytes   // Di ERD tipe: bytee -> Prisma: Bytes (bytea di posgres)

  // Composite Primary Key
  @@id([thread_id, checkpoint_ns, channel, version])
}

model checkpoint_writes {
  thread_id     String
  checkpoint_ns String
  checkpoint_id String
  task_id       String
  idx           Int     // Di ERD tipe: int4 -> Prisma: Int
  task_path     String
  type          String?
  channel       String
  blob          Bytes

  // Composite Primary Key
  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
}

model checkpoint_migrations {
  v Int @id
}

// Encrypted BYOK (Bring Your Own Key) API key storage.
// The raw API key is never persisted  only the AES-256-GCM encrypted form.
// Decryption happens server-side in the chat route immediately before forwarding
// to the LLM provider.
model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  name         String
  provider     String
  modelId      String
  encryptedKey String
  baseUrl      String?
  headers      String?   // JSON string, e.g. {"X-Foo":"bar"}
  temperature  Float?
  maxTokens    Int?
  systemPrompt String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExtensionAccessKey {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash     String    // SHA-256(plainKey)
  keyPrefix   String    // first ~13 chars of plain (UI display)
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([keyHash])
}


model Agent {
  id            String   @id @default(cuid())
  name          String
  status        String   // "active" | "idle" | "error" | "paused" | "initializing"
  lastActiveAt  DateTime @default(now())
  uptimePercent Float    @default(100.0)
  avgLatencyMs  Int      @default(0)
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Mewakili dompet utama pengguna dari hasil top-up
model UserWallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalFundUsd    Float    // Total uang masuk (Contoh: 200.00)
  spentUsd        Float    @default(0) // Total yang sudah dipakai semua agent
  
  // Relasi ke agent-agent yang dimiliki pengguna
  agents          AgentAllocation[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Mewakili Agent dan kuota yang didistribusikan oleh pengguna
model AgentAllocation {
  id              String     @id @default(cuid())
  name            String     // Contoh: "Customer Service Agent"
  walletId        String
  wallet          UserWallet @relation(fields: [walletId], references: [id])
  
  // Limit dana yang boleh dihabiskan agent ini (didistribusikan oleh user)
  // Jika null, artinya agent bisa pakai saldo wallet tanpa batas
  budgetLimitUsd  Float?     

  // ==========================================
  // TRACKING TOKEN (Di-update otomatis oleh LLM)
  // ==========================================
  usedBaseInput   Int        @default(0)
  usedCache5m     Int        @default(0)
  usedCache1h     Int        @default(0)
  usedCacheHit    Int        @default(0)
  usedOutput      Int        @default(0)
  
  // Total uang yang sudah dihabiskan khusus oleh Agent ini
  totalCostUsd    Float      @default(0)

  usageLogs       UsageLog[]
}

// Log setiap kali LLM selesai generate response (Untuk audit & history)
model UsageLog {
  id              String          @id @default(cuid())
  agentId         String
  agent           AgentAllocation @relation(fields: [agentId], references: [id])
  
  baseInput       Int             @default(0)
  cache5m         Int             @default(0)
  cache1h         Int             @default(0)
  cacheHit        Int             @default(0)
  output          Int             @default(0)
  
  costUsd         Float           // Biaya spesifik untuk 1 request ini
  createdAt       DateTime        @default(now())
}

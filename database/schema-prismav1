model Message_InventorExt {
  id        String   @id @default(cuid())
  sessionId String
  content   String   @db.Text
  role      MessageRole
  createdAt DateTime @default(now())
  session   ChatSession_InventorExt @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt])

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  lastActive    DateTime? @default(now())
  joinedDate    DateTime?

  // Application role — persisted in the JWT for fast middleware checks
  role          String    @default("USER")

  // Auth.js relations
  accounts        Account[]
  sessions        Session[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  emailChangeLogs EmailChangeLog[]

  licenses        License[]
  articles        Article[]
  @@map("users")
}

model EmailChangeLog {
  id        String   @id @default(cuid())
  userId    String
  oldEmail  String
  newEmail  String
  createdAt DateTime @default(now())

  // Relationship back to your User model
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  // OAuth token fields — Text to avoid 255-char truncation
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

// Session model is required by PrismaAdapter even when using JWT strategy.
// Auth.js uses it internally for account linking; it does NOT store JWT sessions.
model Session {
  sessionToken  String    @unique
  userId        String
  expires       DateTime

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Shared table for:
//   1. Magic-link tokens      (identifier = email address)
//   2. Change-email tokens    (identifier = "change-email:{userId}:{newEmail}")
//
// Auth.js v5 automatically SHA-256 hashes tokens before calling
// adapter.createVerificationToken, so the `token` column stores only hashes.


model VerificationToken {
  identifier    String
  token         String    @unique
  expires       DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}
model Tool {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String
  docNo         String
  icon          String
  priceUSD      Int
  priceIDR      Int
  tagline       String
  examplePrompt String   @db.Text
  exampleCode   String   @db.Text
  exampleResult String   @db.Text
  how           String   @db.Text
  forWhat       String   @db.Text
  where         String   @db.Text
  whenBuilt     String
  why           String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  licenses      License[]
}

model License {
  id         String   @id @default(cuid())
  userId     String
  toolId     String
  orderId    String   @unique 
  isActive   Boolean  @default(false) 
  licenseKey String?  @unique
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([licenseKey])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique

  // Pemilik artikel — setiap admin hanya bisa melihat/mengubah artikelnya sendiri
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Bahasa Inggris (Default)
  title       String
  desc        String
  content     String   @db.Text
  imageUrl    String?  // Untuk gambar thumbnail
  
  // Bahasa Indonesia
  id_title    String?
  id_desc     String?
  id_content  String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
}

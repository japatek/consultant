generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  lastActive    DateTime? @default(now())
  joinedDate    DateTime?

  // Application role — persisted in the JWT for fast middleware checks
  role          String    @default("USER")

  // Auth.js relations
  accounts        Account[]
  sessions        Session[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  emailChangeLogs EmailChangeLog[]

  licenses        License[]
  articles        Article[]

  // ==========================================================
  // --- Relasi Quest (Misi) / Sertifikasi ---
  // ==========================================================
  authoredQuests   Quest[]             @relation("QuestAuthor")
  questCompletions QuestCompletion[]
  certifications   UserCertification[]
  progress         UserProgress?

  // ==========================================================
  // --- Langganan (Subscription) / Penagihan (Billing) ---
  // ==========================================================
  // Tier yang didenormalisasi — disimpan di User untuk pembacaan cepat 
  // tanpa join. Diperbarui oleh handler callback iPaymu ketika
  // Subscription menjadi ACTIVE/EXPIRED.
  currentTier   String    @default("FREE") // "FREE" | slug dari PricingPlan
  tierExpiresAt DateTime?
  subscriptions Subscription[]

  @@map("users")
}

model EmailChangeLog {
  id        String   @id @default(cuid())
  userId    String
  oldEmail  String
  newEmail  String
  createdAt DateTime @default(now())

  // Relationship back to your User model
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String

  // OAuth token fields — Text to avoid 255-char truncation
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

// Session model is required by PrismaAdapter even when using JWT strategy.
// Auth.js uses it internally for account linking; it does NOT store JWT sessions.
model Session {
  sessionToken  String    @unique
  userId        String
  expires       DateTime

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Shared table for:
//   1. Magic-link tokens      (identifier = email address)
//   2. Change-email tokens    (identifier = "change-email:{userId}:{newEmail}")
//
// Auth.js v5 automatically SHA-256 hashes tokens before calling
// adapter.createVerificationToken, so the `token` column stores only hashes.
model VerificationToken {
  identifier    String
  token         String    @unique
  expires       DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Tool {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String
  docNo         String
  icon          String
  priceUSD      Int
  priceIDR      Int
  tagline       String
  examplePrompt String   @db.Text
  exampleCode   String   @db.Text
  exampleResult String   @db.Text
  how           String   @db.Text
  forWhat       String   @db.Text
  where         String   @db.Text
  whenBuilt     String
  why           String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  licenses      License[]
}

model License {
  id         String   @id @default(cuid())
  userId     String
  toolId     String
  orderId    String   @unique 
  isActive   Boolean  @default(false) 
  licenseKey String?  @unique
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool       Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([licenseKey])
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique

  // PERBAIKAN: Dibuat opsional (?) agar admin hardcoded bisa membuat artikel
  // tanpa memicu error "Foreign key constraint violated"
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Bahasa Inggris (Default)
  title       String
  desc        String
  content     String   @db.Text
  imageUrl    String?  // Untuk gambar thumbnail
  
  // Bahasa Indonesia
  id_title    String?
  id_desc     String?
  id_content  String?  @db.Text
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
}


// ============================================================
// QUEST BUILDER & LEARNING PLATFORM
// ------------------------------------------------------------
// A Quest is a titled SET of Questions (e.g. "Welding Symbols Basics" ->
// 8 questions) at one difficulty level. Completing a quest means answering
// every one of its Questions correctly in the same attempt. A Quest can
// count toward zero or more Certifications (zero = pure training) via the
// CertificationQuest join table, picked by the admin in the Quest Builder.
// ============================================================

enum AnswerType {
  MULTIPLE_CHOICE
  TEXT_INPUT
  FILE_UPLOAD
}

model Quest {
  id           String @id @default(cuid())
  slug         String @unique
  title        String
  difficulty   String // "Beginner" | "Intermediate" | "Advanced" — see src/types/quest.ts
  category     String // subject tag, e.g. "Welding Annotation", "P&ID" — see src/types/quest.ts

  // Swap for a JSON/AST column if you later wire up a structured rich-text
  // editor (Tiptap, Lexical, ...). For now this holds plain/markdown text.
  description  String @db.Text
  instructions String @db.Text

  isPublished  Boolean @default(false)

  authorId String
  author   User   @relation("QuestAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  media          QuestMedia[]
  questions      Question[]
  completions    QuestCompletion[]
  certifications CertificationQuest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([authorId])
  @@map("quests")
}

/** One question within a Quest. Order matters for display; everything about
 *  grading a single answer lives here, same as it used to live on Quest. */
model Question {
  id      String @id @default(cuid())
  questId String
  quest   Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)
  order   Int    @default(0)

  prompt String @db.Text
  points Int    @default(10)

  answerType AnswerType
  // Shape depends on answerType — enforced by Zod on write (src/types/quest.ts),
  // not by Postgres:
  //   MULTIPLE_CHOICE -> { type, options: string[], correctIndex: number }
  //   TEXT_INPUT      -> { type, expectedValue: string, caseSensitive?, tolerance? }
  //   FILE_UPLOAD     -> { type, allowedExtensions: string[], maxSizeMB: number }
  answerConfig Json

  answers QuestionAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questId])
  @@map("questions")
}

model QuestMedia {
  id       String @id @default(cuid())
  questId  String
  quest    Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)
  type     String // "IMAGE" | "VIDEO" | "PDF"
  url      String
  fileName String

  createdAt DateTime @default(now())

  @@index([questId])
  @@map("quest_media")
}

/** One attempt at an entire Quest — rolls up the per-question QuestionAnswer
 *  rows below it. `isCorrect` is only true once every question in THIS
 *  attempt was answered correctly; that's what certification eligibility
 *  checks against (see lib/certification/check-eligibility.ts). */
model QuestCompletion {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId String
  quest   Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)

  attempt      Int      @default(1)
  isCorrect    Boolean  @default(false)
  pointsEarned Int      @default(0)
  completedAt  DateTime @default(now())

  answers QuestionAnswer[]

  @@index([userId, questId])
  @@map("quest_completions")
}

/** One answer to one Question, within one QuestCompletion attempt. */
model QuestionAnswer {
  id                String          @id @default(cuid())
  questCompletionId String
  questCompletion   QuestCompletion @relation(fields: [questCompletionId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  submittedAnswer Json // shape mirrors the Question's answerConfig for the same answerType
  isCorrect       Boolean
  pointsEarned    Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([questCompletionId, questionId])
  @@map("question_answers")
}

model Certification {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String  // e.g. "Associate Drawing Inspector", "Drawing Inspector — Welding Annotation"
  description String  @db.Text
  badgeUrl    String?
  // Retire a certification without deleting it (UserCertification /
  // CertificationQuest rows reference it) — hidden from the Quest
  // Builder's checklist once false, same pattern as PricingPlan.isActive.
  isActive    Boolean @default(true)

  requiredQuests CertificationQuest[]
  unlockedBy     UserCertification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("certifications")
}

// Explicit join table (not an implicit m-n) so a future "required order"
// or "weight per quest" column has somewhere to live.
model CertificationQuest {
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  questId         String
  quest           Quest         @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@id([certificationId, questId])
  @@map("certification_quests")
}

model UserCertification {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  // Public code printed on the certificate for anyone to verify authenticity
  verificationCode String   @unique @default(cuid())
  certificateUrl   String?  // filled in once the PDF/image is generated + uploaded
  unlockedAt       DateTime @default(now())

  @@unique([userId, certificationId])
  @@map("user_certifications")
}

// Denormalized gamification profile — one row per user, cheap to read on
// every dashboard load instead of aggregating QuestCompletion each time.
model UserProgress {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalPoints       Int       @default(0)
  questsCompleted   Int       @default(0)
  currentStreakDays Int       @default(0)
  lastActivityAt    DateTime?

  updatedAt DateTime @updatedAt

  @@map("user_progress")
}

// ============================================================
// PRICING, SUBSCRIPTIONS & IPAYMU PAYMENTS
// ============================================================

enum PlanInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model PricingPlan {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String       // "Weekly", "Monthly", "3 Months"
  interval     PlanInterval
  durationDays Int
  priceIDR     Int
  priceUSD     Int
  features     Json         // string[] — bullet list shown on the pricing card
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)

  // Static iPaymu Payment Link for this plan, created by hand in the
  // iPaymu dashboard (Service > Payment Link) and pasted in here — e.g.
  // https://ipaymu.link/pay/belajar-gambar-teknik-E62BSJ. The "Subscribe"
  // button just opens this URL; keep its price in sync with priceIDR above,
  // since the callback matches payments back to a plan by amount paid
  // (see lib/payment/handle-ipaymu-callback.ts).
  paymentLinkUrl String?

  discounts     Discount[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pricing_plans")
}

model Discount {
  id             String       @id @default(cuid())
  code           String       @unique
  percentOff     Int?         // 0-100, mutually exclusive with amountOffIDR in practice
  amountOffIDR   Int?
  planId         String?      // null = applies to every plan
  plan           PricingPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  validFrom      DateTime     @default(now())
  validUntil     DateTime?
  maxRedemptions Int?
  timesRedeemed  Int          @default(0)
  isActive       Boolean      @default(true)

  createdAt DateTime @default(now())

  @@index([code])
  @@map("discounts")
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  // No onDelete: Cascade here on purpose — deleting a plan should not wipe
  // out historical payment records. Retire a plan via `isActive`, not delete.
  plan   PricingPlan @relation(fields: [planId], references: [id])

  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime?
  endDate   DateTime?

  // iPaymu Payment Link has no dynamic order id we control, so there's no
  // pre-created PENDING row here (unlike a dynamic-checkout flow) — this
  // row is created directly by the callback once a payment is matched to a
  // user + plan. See lib/payment/handle-ipaymu-callback.ts.
  ipaymuTrxId       String  @unique // iPaymu's trx_id — also our idempotency key
  ipaymuReferenceId String? // iPaymu's reference_id, if it sent one
  amountPaidIDR     Int
  discountCodeUsed  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([ipaymuTrxId])
  @@map("subscriptions")
}
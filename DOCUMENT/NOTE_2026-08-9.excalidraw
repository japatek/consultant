      "updated": 1786240247655,
      "link": null,
      "locked": false,
      "text": "{\n\"Version\": \"2008-10-17\",\n\"Id\": \"PolicyForCloudFrontPrivateContent\",\n\"Statement\": [\n    {\n        \"Sid\": \"AllowCloudFrontServicePrincipal\",\n        \"Effect\": \"Allow\",\n        \"Principal\": {\n            \"Service\": \"cloudfront.amazonaws.com\"\n    },\n     \"Action\": \"s3:GetObject\",\n                \"Resource\": \"arn:aws:s3:::japa-media-062995001999-ap-southeast-1-an/*\",\n                \"Condition\": {\n                    \"StringEquals\": {\n                        \"AWS:SourceArn\": \"arn:aws:cloudfront::062995001999:distribution/E3TTQ5S54M5Z3W\"\n                    }\n                }\n            }\n        ]\n    }",
      "fontSize": 32.30164748583411,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "{\n\"Version\": \"2008-10-17\",\n\"Id\": \"PolicyForCloudFrontPrivateContent\",\n\"Statement\": [\n    {\n        \"Sid\": \"AllowCloudFrontServicePrincipal\",\n        \"Effect\": \"Allow\",\n        \"Principal\": {\n            \"Service\": \"cloudfront.amazonaws.com\"\n    },\n     \"Action\": \"s3:GetObject\",\n                \"Resource\": \"arn:aws:s3:::japa-media-062995001999-ap-southeast-1-an/*\",\n                \"Condition\": {\n                    \"StringEquals\": {\n                        \"AWS:SourceArn\": \"arn:aws:cloudfront::062995001999:distribution/E3TTQ5S54M5Z3W\"\n                    }\n                }\n            }\n        ]\n    }",
      "autoResize": false,
      "lineHeight": 1.25
    },

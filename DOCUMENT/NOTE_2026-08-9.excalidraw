      "updated": 1786240247653,
      "link": null,
      "locked": false,
      "text": "Create S3 Bucket\n- Use the bucket\nfor regional.\n- Make sure uploaded\nfolder name was used \nall lowercase.\n(ex= folder-one)\n- Make sure uploaded file\nname was used folder_name\n+ number. ex for file name\n under folder-one 'folder-one-1'",
      "fontSize": 72.18454300621737,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Create S3 Bucket\n- Use the bucket\nfor regional.\n- Make sure uploaded\nfolder name was used \nall lowercase.\n(ex= folder-one)\n- Make sure uploaded file\nname was used folder_name\n+ number. ex for file name\n under folder-one 'folder-one-1'",
      "autoResize": true,
      "lineHeight": 1.25
    },

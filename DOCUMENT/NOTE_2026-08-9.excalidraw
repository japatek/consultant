      "updated": 1783697326242,
      "link": null,
      "locked": false,
      "text": "/filename/dir\nlanguage typescript\nexport function intro(title: string) {\n  console.clear();\n  const banner = figlet.textSync(\"JaPa CLI\", { font: \"Slant\"\n});\n  console.log(gradient.summer(banner));\n  console.log(c.bgEmerald(` ${title} `));\n  console.log(c.zinc(\"│\"));\n}\n\nexport function outro(msg: string) {\n  console.log(c.zinc(`└─ ${pc.yellow(msg)}`));\n}\n\nexport async function userPrompt(message: string, placeholder?:\nstring): Promise<string | null> {\n  const res = await clackText({\n    message: c.emerald(`❯ ${message}`),\n    placeholder,\n  });\n  return typeof res === \"symbol\" ? null : res;\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "/filename/dir\nlanguage typescript\nexport function intro(title: string) {\n  console.clear();\n  const banner = figlet.textSync(\"JaPa CLI\", { font: \"Slant\" });\n  console.log(gradient.summer(banner));\n  console.log(c.bgEmerald(` ${title} `));\n  console.log(c.zinc(\"│\"));\n}\n\nexport function outro(msg: string) {\n  console.log(c.zinc(`└─ ${pc.yellow(msg)}`));\n}\n\nexport async function userPrompt(message: string, placeholder?: string): Promise<string | null> {\n  const res = await clackText({\n    message: c.emerald(`❯ ${message}`),\n    placeholder,\n  });\n  return typeof res === \"symbol\" ? null : res;\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
